<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            style="@style/CardHeader"
            android:text="@string/analytics"
            android:contentDescription="@string/analytics" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/heatmapLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/activity_heatmap"
                android:textSize="14sp"
                android:layout_marginTop="8dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/activity_heatmap" />

            <org.isoron.platform.gui.AndroidDataView
                android:id="@+id/heatmapChart"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/trendLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/trend"
                android:textSize="14sp"
                android:layout_marginTop="16dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/trend" />

            <org.isoron.uhabits.activities.common.views.TrendChartView
                android:id="@+id/trendChart"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/chainTimelineLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chain_timeline"
                android:textSize="14sp"
                android:layout_marginTop="16dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/chain_timeline" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/chainTimelineRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal" />

        </LinearLayout>

    </LinearLayout>

</merge>
