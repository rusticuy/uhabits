<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/pref_lock_setup"
        android:textAppearance="?attr/textAppearanceHeadline5"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/instructionText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/enter_pin_instruction"
        android:textAppearance="?attr/textAppearanceBody1"
        android:layout_marginBottom="24dp" />

    <EditText
        android:id="@+id/pinInputFirst"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="numberPassword"
        android:maxLength="10"
        android:layout_marginBottom="16dp"
        android:hint="@string/pin_input_hint" />

    <EditText
        android:id="@+id/pinInputConfirm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="numberPassword"
        android:maxLength="10"
        android:layout_marginBottom="24dp"
        android:hint="@string/pin_confirm_hint" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_horizontal"
        android:spacing="8dp">

        <Button
            android:id="@+id/clearButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/clear_label"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/savePinButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/save"
            android:layout_marginStart="8dp" />

    </LinearLayout>

</LinearLayout>
